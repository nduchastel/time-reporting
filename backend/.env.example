# Server Configuration
PORT=3001

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key — used for admin/storage operations. Optional locally (falls back to anon).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI Configuration
OPENAI_API_KEY=sk-your-key

# Auth — REQUIRED in production. Secret used to sign/verify JWT session tokens.
JWT_SECRET=change-me-to-a-long-random-string

# CORS allowlist (Phase 4). Comma-separated list of origins allowed to call the API.
# When unset, dev defaults to localhost:5173 / :3001. Set to your Vercel domain(s) in prod.
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# Error monitoring (Phase 4). DSN for the hosted error tracker.
# When unset, error reporting is a no-op (local + tests stay offline).
# SENTRY_DSN=

# Environment
NODE_ENV=development
